# ── Database ──────────────────────────────────
POSTGRES_USER=nutrix
POSTGRES_PASSWORD=changeme
POSTGRES_DB=nutrix_db
DATABASE_URL=postgresql://nutrix:changeme@postgres:5432/nutrix_db

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Auth ──────────────────────────────────────
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=720
DEVICE_TOKEN=NutriX_ESP32_SECURE_TOKEN

# ── External APIs ─────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# ── Internal Service URLs (for multi-machine) ─
MS1_CV_URL=http://ms1-cv:8001
MS2_LLM_URL=http://ms2-llm:8003
MS3_USER_URL=http://ms3-user:8002
MS4_AGENTS_URL=http://ms4-agents:8004

# ── MS2 Vision-Language Model (Qwen3-VL-2B via transformers) ──
# Local snapshot dir (Windows HF cache seen from WSL). Remove to download from the HF hub.
VLM_MODEL_PATH=/mnt/c/Users/HP/.cache/huggingface/hub/models--Qwen--Qwen3-VL-2B-Instruct/snapshots/89644892e4d85e24eaac8bacfd4f463576704203
VLM_MAX_NEW_TOKENS=128
VLM_MAX_PIXELS=307200
# true = load once at startup and stay resident; false = load per call, free after
VLM_KEEP_LOADED=true
# MS1 -> MS2 request timeout (seconds)
MS2_TIMEOUT_S=30
# YOLO classes treated as unidentified (sent to the VLM instead)
YOLO_SUPPRESSED_CLASSES=lassi,kulfi
# YOLO confidence (0-1) required to skip the VLM fallback
YOLO_CONF_THRESHOLD=0.5

# ── MS3 (User & Analytics) ─────────────────────────────────────────────────────
# dev = mock Google tokens + dev dashboard (/dev-ui) + insecure JWT fallback; anything else = strict
ENV=dev
# serve the old unprefixed paths (existing app/dashboard) next to /api/v1/...
ENABLE_LEGACY_ROUTES=true
# comma separated list of allowed origins for browsers/Flutter web ('*' = any)
CORS_ORIGINS=*
# Gemini is used by MS3 for coach / diet plan / recipe generation / barcode / OCR
GEMINI_MODEL=gemini-3.5-flash-lite
# tried in order when the primary model is unknown/retired or overloaded
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3-flash-preview
# MS1: create an unknown scale User-ID on the fly (bench testing only; accounts normally come from MS3 register)
AUTO_CREATE_DEV_USER=true
# Scans nobody could identify (YOLO and Qwen both gave up) are not saved, so "Unknown" never reaches the app. true = keep them.
LOG_UNKNOWN_SCANS=false
GEMINI_REQUEST_TIMEOUT=10
# when Gemini is unavailable, answer AI text features with the local Qwen model on MS2 (llm/generate)
AI_LOCAL_FALLBACK=true
# optional JSON merged into every Gemini request, e.g. {"thinkingConfig": {"thinkingBudget": 0}, "maxOutputTokens": 600}
# (find what works with: PYTHONPATH=. python scripts/benchmark_gemini.py --variants)
GEMINI_GENERATION_CONFIG=
# The user's calendar day for meal logs, dashboard 'today' and analytics (IANA name)
APP_TIMEZONE=Asia/Kolkata
